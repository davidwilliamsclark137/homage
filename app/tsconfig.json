{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "parked-routes/**",
    "screens/**",
    "state/**",
    "hooks/useProgress.ts",
    "hooks/useQuestSync.ts"
  ]
}
